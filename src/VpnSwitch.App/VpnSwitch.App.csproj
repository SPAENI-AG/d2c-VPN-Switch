<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>D2C-VPN-Switch</AssemblyName>
    <RootNamespace>VpnSwitch.App</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Version kommt aus Directory.Build.props (<Version>) -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VpnSwitch.Core\VpnSwitch.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <!-- Hilfe-Seiten liegen neben der exe (auch bei Einzeldatei-Veröffentlichung) -->
    <Content Include="Help\**\*" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
