<Window x:Class="VpnSwitch.App.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:VpnSwitch.App"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{StaticResource AppBackgroundBrush}" FontFamily="Segoe UI"
        Icon="pack://application:,,,/Assets/icon.ico" FocusManager.FocusedElement="{Binding ElementName=tb_Input}">
    <Border Margin="12" Padding="16,14" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6">
        <StackPanel>
            <TextBlock x:Name="tb_Text" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBox x:Name="tb_Input"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="{l:Tr Btn_Ok}" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="bt_Ok_Click"/>
                <Button Content="{l:Tr Btn_Cancel}" IsCancel="True" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
